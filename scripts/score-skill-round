#!/usr/bin/env python3
"""Scores the recall of one round of skill discovery's script against Jev (ADR-0015, ADR-0016).

    scripts/score-skill-round <round number>

Runs scripts/skill_discovery.py over the segments of IN and the pile, then measures recall: draws
segments of IN and the pile, uniformly over the export, so each in proportion to its size; the export
holds requirement text only, boilerplate and headings left out. The names found in a segment are the
plain keys of skills.tsv and the candidates. Each segment is cut into name-like pieces and filtered
(skillloop.Recall), and Jev keeps or drops each piece left, in its segment, under the skill criterion.
A segment is missed when a piece is kept, covered when a name was found and no piece is kept. Recall is
covered over covered and missed, and its gate is RECALL. Precision and yield are no gates: the agents
of a discovery run read every candidate (ADR-0016).

The missed segments are printed with the names Jev kept, and those names, once by name form, go to
skill-missed-round-<round>-<snapshot>.txt next to the snapshot, one a line, beside the round's
candidates in skill-candidates-round-<round>-<snapshot>.tsv. A name the script never proposes is lost
for good, so scripts/discover-skills batch reads both: the candidates, and the missed names as
candidates of their own.

The draw takes no segment an earlier round drew, and each round's draw goes into
docs/measurements/skill-rounds-drawn.tsv; its `candidate` rows are the precision draws of rounds 0-3.
Running a round again redraws the same segments and replaces its own draw; every Jev label is cached by
skillloop and never remade, so a round stopped by an error or the $4 stop is resumed by running it
again. The report is archived as docs/measurements/skill-round-<round>.txt.
"""

import subprocess
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
import jev  # noqa: E402
import skill_discovery  # noqa: E402
import skillloop  # noqa: E402

DISCOVERY = Path(__file__).resolve().parent / "skill_discovery.py"

CANDIDATES = skillloop.SEGMENTS.parent / f"skill-candidates-round-{{round}}-{skillloop.SNAPSHOT}.tsv"

# The names Jev kept in the missed segments, which discover-skills batch reads beside the candidates.
MISSED = skillloop.SEGMENTS.parent / f"skill-missed-round-{{round}}-{skillloop.SNAPSHOT}.txt"

DRAWN = skillloop.REPO / "docs" / "measurements" / "skill-rounds-drawn.tsv"

ARCHIVE = skillloop.REPO / "docs" / "measurements" / "skill-round-{round}.txt"

RECALL_SIZE = 2400

# ADR-0013's gate, the one ADR-0016 keeps.
RECALL = 0.90


class Report:
    """Prints to the terminal and to the round's archive."""

    def __init__(self, archive):
        self.archive = archive

    def __call__(self, line=""):
        print(line)
        self.archive.write(line + "\n")


def read_drawn():
    """Every row an earlier round drew, as round, kind (`candidate` by name form or `segment` by text)
    and what was drawn."""
    if not DRAWN.exists():
        return []
    with open(DRAWN) as lines:
        return [line.rstrip("\n").split("\t") for line in lines if line.strip()][1:]


def record_drawn(round_name, segments):
    rows = [row for row in read_drawn() if row[0] != round_name]
    rows += [[round_name, "segment", text] for text in segments]
    DRAWN.write_text("round\tkind\tdrawn\n" + "".join("\t".join(row) + "\n" for row in rows))


def discover(round_name):
    """Runs the discovery script, and returns its candidates."""
    path = Path(str(CANDIDATES).format(round=round_name))
    subprocess.run([sys.executable, str(DISCOVERY), str(path)], check=True)
    return skill_discovery.read_candidates(path)


def draw_segments(round_name, lines, earlier, names):
    """The segments drawn for recall, each a distinct text, with its vacancy, the names found in it and
    where."""
    order = skillloop.shuffled(range(len(lines)), f"round-{round_name}-segments")
    drawn, seen = [], set(earlier)
    for index in order:
        if len(drawn) == RECALL_SIZE:
            break
        vacancy_id, text = lines[index].rstrip("\n").split("\t", 1)
        if text in seen:
            continue
        seen.add(text)
        drawn.append({"vacancy_id": vacancy_id, "segment": text, "names": names.named_in(text),
                      "found": names.spans_in(text)})
    return drawn


def missed_names(outcomes):
    """The names Jev kept in the missed segments, once by name form, in the order the segments were
    drawn."""
    names = {}
    for _, outcome, kept in outcomes:
        if outcome == "missed":
            for name in kept:
                names.setdefault(skillloop.name_form(name), name)
    return list(names.values())


def score(report, round_name, candidates, recall_drawn, recall):
    """Reports the round's recall, and returns the names Jev kept in its missed segments."""
    report(f"Round {round_name} at criterion revision {skillloop.criterion_revision()}, {jev.MODEL}")
    report(f"\nSize: {len(candidates)} candidates")

    outcomes = recall.score(recall_drawn)
    count = {outcome: sum(found == outcome for _, found, _ in outcomes) for outcome in ("covered", "missed", "none", "unjudged")}
    bearing = count["covered"] + count["missed"]
    if bearing:
        low, high = skillloop.wilson(count["covered"], bearing)
        share = count["covered"] / bearing
        report(f"Recall: {count['covered']}/{bearing} skill-bearing segments missed nothing = {share:.1%}, "
               f"95% interval {low:.1%}-{high:.1%}, gate {RECALL:.0%}  {'pass' if share >= RECALL else 'FAIL'}")
        passed = share >= RECALL and not count["unjudged"]
    else:
        report("Recall: no skill-bearing segment  FAIL")
        passed = False
    report(f"  {len(recall_drawn)} segments drawn, {count['none']} naming no skill, {count['unjudged']} not yet judged")
    report(f"\n{'Recall holds: the script stands' if passed else 'Recall fails: the script changes'}")

    missed = [(row, kept) for row, outcome, kept in outcomes if outcome == "missed"]
    report(f"\nSegments that name a skill not found ({len(missed)}), with the names Jev kept:")
    for row, kept in missed:
        report(f"\n  vacancy {row['vacancy_id']}  kept: {' | '.join(kept)}")
        report(f"  found: {', '.join(row['names']) or 'nothing'}")
        report(f"  {row['segment']}")

    names = missed_names(outcomes)
    report(f"\n{len(names)} names kept and not proposed, written to {str(MISSED).format(round=round_name)}")

    report(f"\nJev has cost ${jev.spend():.4f} over every run of both issues, of the ${jev.SPEND_LIMIT:.2f} limit")
    return names


def main():
    if len(sys.argv) != 2 or not sys.argv[1].isdigit():
        sys.exit(__doc__.strip())
    round_name = sys.argv[1]
    # The export is made once per snapshot, not by the script.
    lines = skillloop.read_segment_lines()
    skillloop.read_companies()

    print(f"Round {round_name}: running the discovery script")
    candidates = discover(round_name)
    print(f"  {len(candidates)} candidates")

    earlier_segments = {drawn for round_drawn, kind, drawn in read_drawn() if round_drawn != round_name and kind == "segment"}
    names = skillloop.Names(skillloop.read_keys("plain", spelled=True), [c["name"] for c in candidates],
                            skillloop.read_keys())
    recall_drawn = draw_segments(round_name, lines, earlier_segments, names)
    record_drawn(round_name, [row["segment"] for row in recall_drawn])

    recall = skillloop.Recall(lines)
    skillloop.label_pieces([{"name": name, "segment": row["segment"]}
                            for row in recall_drawn for name in recall.pieces(row).values()])

    print()
    with open(str(ARCHIVE).format(round=round_name), "w") as archive:
        missed = score(Report(archive), round_name, candidates, recall_drawn, recall)
    Path(str(MISSED).format(round=round_name)).write_text("".join(name + "\n" for name in missed))


if __name__ == "__main__":
    main()
