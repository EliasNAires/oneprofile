#!/usr/bin/env python3
"""One burst against one ATS host for a pace measurement (ADR-0025): one request per slug of a
file, a number at a time, each worker keeping one connection alive, sending the app's user agent
and no Accept-Encoding, as the app's HttpClient does.

    scripts/pace-burst <label> <url-template with {slug}> <at-a-time> <slugs-file> <out.jsonl>
    scripts/pace-burst lever-eu 'https://api.eu.lever.co/v0/postings/{slug}?mode=json&limit=1' 16 \
        eu.slugs out/lever-eu.jsonl

Prints one JSON line: the rate, the median, 95th percentile and slowest answer, every status,
the megabytes downloaded and when the first refusal came. Writes every answer to out.jsonl, with
any rate-limit or retry header and the start of any body that was neither 200 nor 404. Stops
after 20 refusals, enough to know.

The checks after a ramp are bursts too. Whether two region hosts, or a probe and a sweep, share a
limit: run two at once, one with `&`, and compare each with its rate alone. Whether a rate holds:
one burst of several thousand slugs.
"""
import http.client, json, statistics, sys, threading, time, urllib.parse
from concurrent.futures import ThreadPoolExecutor

UA = "oneprofile (+https://github.com/EliasNAires/oneprofile)"
REFUSED = {403, 429, 503, 520, 521, 522, 523, 524}
label, template, conc, slugs_file, out = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4], sys.argv[5]
slugs = [s.strip() for s in open(slugs_file) if s.strip()]
local = threading.local()
stop = threading.Event()
refusals = [0]
lock = threading.Lock()


def conn(host):
    c = getattr(local, "c", None)
    if c is None:
        c = local.c = http.client.HTTPSConnection(host, timeout=180)
    return c


def one(slug):
    if stop.is_set():
        return None
    url = urllib.parse.urlsplit(template.format(slug=slug))
    path = url.path + ("?" + url.query if url.query else "")
    t0 = time.monotonic()
    rec = {"slug": slug, "start": t0}
    for attempt in range(2):  # a dropped keep-alive connection is reopened once
        try:
            c = conn(url.hostname)
            c.request("GET", path, headers={"User-Agent": UA, "Connection": "keep-alive"})
            r = c.getresponse()
            body = r.read()
            rec.update(status=r.status, bytes=len(body))
            h = {k.lower(): v for k, v in r.getheaders()}
            keep = {k: v for k, v in h.items() if "rate" in k or "retry" in k or k in ("server", "cf-cache-status", "x-cache", "cf-mitigated")}
            if keep:
                rec["headers"] = keep
            if r.status not in (200, 404):
                rec["body"] = body[:300].decode("utf-8", "replace")
            if h.get("connection", "").lower() == "close":
                c.close(); local.c = None
            break
        except Exception as ex:  # noqa: BLE001
            try:
                local.c.close()
            except Exception:
                pass
            local.c = None
            rec.update(status="error", error=repr(ex)[:200])
            if attempt == 1:
                break
    rec["secs"] = time.monotonic() - t0
    if rec["status"] in REFUSED:
        with lock:
            refusals[0] += 1
            if refusals[0] >= 20:  # enough to know; don't keep pressing
                stop.set()
    return rec


t0 = time.monotonic()
with ThreadPoolExecutor(conc) as pool:
    recs = [r for r in pool.map(one, slugs) if r]
wall = time.monotonic() - t0
with open(out, "w") as f:
    for r in recs:
        r["start"] -= t0
        f.write(json.dumps(r) + "\n")
secs = sorted(r["secs"] for r in recs)
statuses = {}
for r in recs:
    statuses[str(r["status"])] = statuses.get(str(r["status"]), 0) + 1
first_refusal = next((round(r["start"], 1) for r in sorted(recs, key=lambda r: r["start"]) if r["status"] in REFUSED), None)
mb = sum(r.get("bytes", 0) for r in recs) / 1e6
print(json.dumps({
    "burst": label, "conc": conc, "requests": len(recs), "wall": round(wall, 1), "rate": round(len(recs) / wall, 2),
    "median": round(statistics.median(secs), 2), "p95": round(secs[int(0.95 * (len(secs) - 1))], 2), "max": round(secs[-1], 2),
    "statuses": statuses, "MB": round(mb, 1), "MBps": round(mb / wall, 2), "first_refusal_at": first_refusal,
}), flush=True)
