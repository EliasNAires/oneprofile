#!/usr/bin/env python3
"""Scores one eligibility group rule-loop round (#103, ADR-0031).

    scripts/score-eligibility-round ROUND [NAME]

Run after POST /country-sets. Each invocation advances docs/measurements/eligibility-round-ROUND[-NAME]:
draw up to 35 description promises, 10 eligible from location or title, 25 cued rest and 10 plain rest
per visitor group (seed 10300 + ROUND),
ask eligibility-labeller for both verdicts per group, then write blind disagreements in
disagreements/batch-NNN.json, 20 items a batch. The adjudicator writes batch-NNN.verdicts.json:
{id: {verdict: a|b|neither, clause, pattern}}. Items have vacancy:group ids and name the question.
Once settled, print each group's promises (Wilson 95%) and population-weighted reach (bootstrap 95%),
raw labeller figures, winners and patterns. Archive beside the round, with commit and revision.

Gate 1 scores only description promises at 90%. Reach weights eligible shares separately by the
description and eligible-other populations, over those plus population-weighted open shares in the
rest strata. The bootstrap resamples all four strata. Older draws without eligible-other use promises
precision for every eligible source; their reach is not comparable with round baselines.
Gate 2 guards non-regression: reach must be at least the group's round-0 baseline minus 5 points.
Round 0 sets that baseline and leaves gate 2 unassessed; later rounds fail if it is unset.
Targets (latam 70%, us 90%, english 80%) are reported but do not decide whether a round holds.

Only cue segments are shown, capped at the sampler's segment length, without neighbours. A vacancy
drawn for several groups is labelled once. Identical shown texts share labels through same.tsv.
Revision-matched kept labels go into batch-0.txt and labels-0.tsv; new texts into batches of 50.
Every batch reports its rows and estimated tokens (characters / 4), including the mean per row.
The reusable draw accepts excluded ids; rounds exclude none. No gold-set labels are read here.
"""

import csv
import hashlib
import io
import json
import math
import random
import re
import subprocess
import sys
from collections import Counter, defaultdict
from contextlib import redirect_stdout
from importlib.machinery import SourceFileLoader
from pathlib import Path

sys.dont_write_bytecode = True
SCRIPTS = Path(__file__).resolve().parent
sampler = SourceFileLoader("eligibility_sampler", str(SCRIPTS / "draw-eligibility-sample")).load_module()
REPO = sampler.REPO
MEASUREMENTS = REPO / "docs" / "measurements"
KEPT = MEASUREMENTS / "eligibility-group-labels.tsv"
CRITERION = REPO / "docs" / "eligibility-criterion.md"
BATCH = 50
ADJUDICATION_BATCH = 20
SEED = 10300
Z = 1.96
GROUPS = {"latam": ("AR", "BR", "MX", "CO", "CL"), "us": ("US",),
          "english": ("GB", "CA", "AU", "NZ", "IE")}
sampler.COUNTRIES = tuple(code for codes in GROUPS.values() for code in codes)
PROMISES = 35
OTHERS = 10
CUED = 25
PLAIN = 10
PROMISE_LINE = .9
REACH_TARGETS = {"latam": .70, "us": .90, "english": .80}
REACH_BASELINE = {"latam": .855, "us": 1.0, "english": .842}
REACH_TOLERANCE = .05
STRATA = ("promise", "eligible-other", "rest-cued", "rest-plain")
VERDICTS = [f"{group}-{kind}" for group in GROUPS for kind in ("rule", "reader")]
LABEL_HEADER = ["id", *VERDICTS, "reason"]


def rows(path):
    with open(path, encoding="utf-8", newline="") as source:
        return list(csv.DictReader(source, delimiter="\t"))


def write_rows(path, header, data):
    with open(path, "w", encoding="utf-8", newline="") as out:
        writer = csv.writer(out, delimiter="\t", lineterminator="\n")
        writer.writerow(header)
        writer.writerows(data)


def revision():
    return max(map(int, re.findall(r"\*\*Revision (\d+)\*\*", CRITERION.read_text(encoding="utf-8"))), default=1)


def cues():
    names = ["LATAM", "Latin America", "South America", "Americas", "AMER", "Worldwide", "Global",
             "Anywhere", "EMEA", "APAC", "ANZ", "North America", "Europe"]
    places = REPO / "src" / "main" / "resources" / "places"
    if (places / "countries.tsv").exists():
        names.extend(row["name"] for row in rows(places / "countries.tsv"))
    if (places / "regions.tsv").exists():
        names.extend(row["region"] for row in rows(places / "regions.tsv"))
    return re.compile(sampler.BROAD_CUE.pattern + r"|\boffice|\bon-?site|\bhybrid|\bhire|"
                      + r"\b(?:" + "|".join(re.escape(name) for name in sorted(set(names))) + r")\b", re.I)


CUE = cues()


def group_state(row, group):
    countries = [row[code] for code in GROUPS[group]]
    state = next(state for state in ("ELIGIBLE", "UNKNOWN", "EXCLUDED")
                 if any(country["state"] == state for country in countries))
    source = next((source for source in ("LOCATION", "TITLE", "DESCRIPTION")
                   if any(country["state"] == "ELIGIBLE" and country["source"] == source
                          for country in countries)), None)
    return state, source


def group_cues():
    places = REPO / "src" / "main" / "resources" / "places"
    countries, regions = rows(places / "countries.tsv"), rows(places / "regions.tsv")
    common = r"\banywhere\b|\bworldwide\b|\bhire (?:globally|worldwide)|\bDeel\b|employer of record|\bEOR\b"
    extra = {"latam": r"\bLATAM\b|\bLatin|\bArgentin|\bBrasil|\bMéxico",
             "us": r"\bU\.S\.(?:A\.)?|\bUSA?\b",
             "english": r"\bUK\b|\bBritish\b|\bEngland\b|\bScotland\b|\bWales\b|\bANZ\b"}
    found = {}
    for group, codes in GROUPS.items():
        names = {row["name"] for row in countries if row["code"] in codes}
        names.update(row["region"] for row in regions if row["country"] in codes or row["country"] == "*")
        found[group] = re.compile(common + "|" + extra[group] + r"|\b(?:" +
                                  "|".join(re.escape(name) for name in sorted(names)) + r")\b", re.I)
    return found


GROUP_CUES = group_cues()


def shown(row, segments, stratum=None):
    """The block whose digest identifies a label; no id or rule prediction is included."""
    stated = {s.get("segment") for s in row["sets"] if s["source"] == "DESCRIPTION"
              and s.get("segment") is not None}
    texts = [sampler.marked(s) for index, s in enumerate(segments)
             if CUE.search(s["text"]) or index in stated]
    return (f"company: {sampler.flat(row['company'])}\ntitle: {sampler.flat(row['title'])}\n"
            f"options: {sampler.options(row)}\ndescription:\n" + ("\n".join(texts) or "-")).strip()


def digest(text):
    return hashlib.sha1(text.strip().encode("utf-8")).hexdigest()


def kept():
    return {(row["digest"], row["revision"]): tuple(row[column] for column in (*VERDICTS, "reason"))
            for row in rows(KEPT)} if KEPT.exists() else {}


def draw(directory, vacancies, seed=SEED, exclude=(), kept=None):
    """Draw each group's strata independently; kept(text) returns six verdicts and a reason.

    Promise and eligible-other are disjoint: group_state's LOCATION, TITLE, DESCRIPTION source
    order assigns a group eligible through location or title to eligible-other alone.
    """
    directory.mkdir(parents=True, exist_ok=True)
    rng = random.Random(seed)
    excluded = set(map(str, exclude))
    available = sorted((row for row in vacancies if str(row["id"]) not in excluded),
                       key=lambda row: int(row["id"]))
    states = {row["id"]: {group: group_state(row, group) for group in GROUPS} for row in available}
    cued, needs = {}, []
    for row in available:
        text = row["title"] + " " + sampler.options(row)
        cued[row["id"]] = {group: bool(GROUP_CUES[group].search(text)) for group in GROUPS}
        if any(states[row["id"]][group][0] != "ELIGIBLE" and not cued[row["id"]][group]
               for group in GROUPS):
            needs.append(row["id"])
    segments = sampler.segments_of(needs) if needs else {}
    for id in needs:
        text = "\n".join(segment["text"] for segment in segments.get(id, []))
        for group in GROUPS:
            cued[id][group] |= bool(GROUP_CUES[group].search(text))
    drawn, strata = {}, []
    for group in GROUPS:
        for stratum, size in zip(STRATA, (PROMISES, OTHERS, CUED, PLAIN)):
            pool = [row for row in available if
                    (states[row["id"]][group] == ("ELIGIBLE", "DESCRIPTION") if stratum == "promise" else
                     states[row["id"]][group][0] == "ELIGIBLE" and
                     states[row["id"]][group][1] in ("LOCATION", "TITLE") if stratum == "eligible-other" else
                     states[row["id"]][group][0] != "ELIGIBLE" and
                     cued[row["id"]][group] == (stratum == "rest-cued"))]
            chosen = rng.sample(pool, min(size, len(pool)))
            strata.append((group, stratum, len(pool), len(chosen)))
            print(f"{group} {stratum}: {len(pool)} vacancies, {len(chosen)} drawn")
            for row in chosen:
                drawn.setdefault(row["id"], (row, []))[1].append(f"{group}:{stratum}")
        strata.append((group, "eligible", sum(states[row["id"]][group][0] == "ELIGIBLE"
                                             for row in available), ""))
    write_rows(directory / "strata.tsv", ["group", "stratum", "size", "drawn"], strata)
    write_rows(directory / "sample.tsv", ["id", "ats", "title", "options", "drawn", *GROUPS],
               ([row["id"], row["ats"], sampler.flat(row["title"]), sampler.options(row), " ".join(names),
                 *(states[row["id"]][group][0].lower() for group in GROUPS)]
                for row, names in sorted(drawn.values(), key=lambda item: int(item[0]["id"]))))
    missing = [id for id in drawn if id not in segments]
    if missing:
        segments.update(sampler.segments_of(missing))
    order = list(drawn.values())
    rng.shuffle(order)
    first, same, known, fresh = {}, [], [], []
    for row, names in order:
        text = shown(row, segments.get(row["id"], []))
        if text in first:
            same.append((row["id"], first[text]))
            continue
        first[text] = row["id"]
        label = kept(text) if kept else None
        if label is not None:
            known.append((row["id"], text, label))
        else:
            fresh.append((row["id"], text))
    write_rows(directory / "same.tsv", ["id", "same_as"], same)
    if known:
        write_batch(directory / "batch-0.txt", [(id, text) for id, text, _ in known])
        write_rows(directory / "labels-0.tsv", LABEL_HEADER, ([id, *label] for id, _, label in known))
    for number, start in enumerate(range(0, len(fresh), BATCH), 1):
        write_batch(directory / f"batch-{number}.txt", fresh[start:start + BATCH])
    print(f"{len(drawn)} vacancies drawn, {len(same)} reuse a twin, {len(known)} kept, {len(fresh)} unique rows to label")


def write_batch(path, batch):
    body = "".join(f"=== {id}\n{text}\n\n" for id, text in batch)
    path.write_text(body, encoding="utf-8")
    tokens = len(body) / 4
    print(f"{path.name}: {len(batch)} rows, estimated {tokens:.0f} tokens, mean {tokens / len(batch):.1f} per row")


def blocks(directory):
    seen = {}
    for path in sorted(directory.glob("batch-*.txt")):
        for block in re.split(r"^=== ", path.read_text(encoding="utf-8"), flags=re.M)[1:]:
            id, _, text = block.partition("\n")
            seen[id.strip()] = text.strip()
    for row in rows(directory / "same.tsv"):
        seen[row["id"]] = seen[row["same_as"]]
    return seen


def labels(directory, sample, same):
    loaded = [row for path in sorted(directory.glob("labels-*.tsv")) for row in rows(path)]
    validate_labels(loaded, "labeller")
    found = {row["id"]: row for row in loaded}
    for row in rows(same):
        if row["same_as"] in found:
            found[row["id"]] = found[row["same_as"]]
    missing = sum(row["id"] not in found for row in sample)
    if missing:
        sys.exit(f"{missing} rows lack a labeller's label")
    return found


def validate_labels(labelled, owner):
    invalid = sum(any(row.get(column) not in (("eligible", "excluded", "unknown")
                      if column.endswith("-rule") else ("open", "closed", "unclear"))
                      for column in VERDICTS) for row in labelled)
    if invalid:
        sys.exit(f"{invalid} {owner} rows have missing or invalid verdicts")


def keep(directory, current):
    store, seen, new = kept(), blocks(directory), []
    for path in sorted(directory.glob("labels-*.tsv")):
        if path.stem == "labels-0":
            continue
        for row in rows(path):
            key = (digest(seen[row["id"]]), str(current))
            if key not in store:
                store[key] = tuple(row[column] for column in (*VERDICTS, "reason"))
                new.append((*key, *store[key]))
    if new:
        exists = KEPT.exists()
        with open(KEPT, "a", encoding="utf-8", newline="") as out:
            writer = csv.writer(out, delimiter="\t", lineterminator="\n")
            if not exists:
                writer.writerow(["digest", "revision", *VERDICTS, "reason"])
            writer.writerows(new)
        print(f"kept {len(new)} new labels under revision {current}")


def wilson(hits, total):
    share = hits / total
    centre = (share + Z * Z / (2 * total)) / (1 + Z * Z / total)
    half = Z * math.sqrt(share * (1 - share) / total + Z * Z / (4 * total * total)) / (1 + Z * Z / total)
    return centre - half, centre + half


def share(hits, total):
    if not total:
        return "none judged"
    low, high = wilson(hits, total)
    return f"{hits}/{total} = {hits / total:.1%} (95% Wilson {low:.1%}-{high:.1%})"


def batches(directory, prefix):
    return sorted(path for path in directory.glob(f"{prefix}-*.json") if not path.name.endswith(".verdicts.json"))


def adjudicate(directory, prefix, differing, seen, answers, sides, owner, seed=SEED, items=None):
    """Write a part once, shuffled with unattributed answers, and keep its side mapping."""
    if batches(directory, prefix):
        return
    rng = random.Random(seed)
    order = list(differing)
    rng.shuffle(order)
    for start in range(0, len(order), ADJUDICATION_BATCH):
        batch = []
        for id in order[start:start + ADJUDICATION_BATCH]:
            first, second = rng.sample("ab", 2)
            sides[id] = {owner: first, "labeller": second}
            a, b = answers[id]
            item = items[id] if items else {}
            batch.append({"id": id, "text": seen[id], first: a, second: b,
                          **{key: item[key] for key in ("group", "asks") if key in item}})
        (directory / f"{prefix}-{start // ADJUDICATION_BATCH + 1:03}.json").write_text(
            json.dumps(batch, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")


def verdicts(directory, prefix, sides, owner):
    found = {}
    for path in directory.glob(f"{prefix}-*.verdicts.json"):
        found.update(json.loads(path.read_text(encoding="utf-8")))
    written = {row["id"] for path in batches(directory, prefix) for row in json.loads(path.read_text(encoding="utf-8"))}
    if set(found) - written:
        sys.exit("Verdicts contain rows outside their adjudication batches")
    for id, row in found.items():
        if row["verdict"] not in (sides[id][owner], sides[id]["labeller"], "neither"):
            sys.exit("Invalid adjudicator verdict")
    return found


def items(sample, labelled):
    """One scored item for every drawn vacancy and group, with binary rest answers."""
    found = {}
    for row in sample:
        for name in row["drawn"].split():
            group, stratum = name.split(":")
            eligible = stratum in ("promise", "eligible-other")
            answer = labelled[row["id"]][f"{group}-{'rule' if eligible else 'reader'}"]
            found[f"{row['id']}:{group}"] = {
                "vacancy": row["id"], "group": group, "stratum": stratum,
                "rule": "eligible" if eligible else "not open",
                "answer": answer if eligible else "open" if answer == "open" else "not open",
                "asks": "rule verdict for the group" if eligible else "reader verdict for the group: open or not open"}
    return found


def gates(scored, settled, strata, group):
    """Promises and source-weighted reach; older draws use promises precision for all eligible."""
    sizes = {row["stratum"]: int(row["size"]) for row in strata if row["group"] == group}
    legacy = "eligible-other" not in sizes
    eligible = ("promise",) if legacy else ("promise", "eligible-other")
    rest = ("rest-cued", "rest-plain")
    counts = {}
    for stratum in STRATA:
        ids = [id for id, item in scored.items() if item["group"] == group and item["stratum"] == stratum]
        answer = "eligible" if stratum in eligible else "open"
        counts[stratum] = (sum(settled[id] == answer for id in ids), len(ids))
    hits, total = counts["promise"]
    promise = hits / total if total else None
    # An unjudged nonempty population cannot supply a share.
    if (legacy and sizes["eligible"] and promise is None) or any(
            sizes[name] and not counts[name][1] for name in (*eligible, *rest)):
        return {"hits": hits, "total": total, "promise": promise, "reach": None}
    numerator = sizes["eligible"] * (promise or 0) if legacy else sum(
        sizes[name] * (counts[name][0] / counts[name][1] if counts[name][1] else 0)
        for name in eligible)
    denominator = numerator + sum(sizes[name] * (counts[name][0] / counts[name][1] if counts[name][1] else 0)
                                  for name in rest)
    return {"hits": hits, "total": total, "promise": promise,
            "reach": numerator / denominator if denominator else None}


def bootstrap(scored, settled, strata, group, seed=SEED, resamples=2000):
    """Seeded percentile interval for reach, independently resampling each stratum's items."""
    rng = random.Random(seed)
    groups = [[id for id, item in scored.items() if item["group"] == group and item["stratum"] == name]
              for name in STRATA]
    estimates = []
    for _ in range(resamples):
        answers = {id: settled[rng.choice(ids)] for ids in groups for id in ids}
        reach = gates(scored, answers, strata, group)["reach"]
        if reach is not None:
            estimates.append(reach)
    if not estimates:
        return None
    estimates.sort()
    return estimates[int(.025 * (len(estimates) - 1))], estimates[int(.975 * (len(estimates) - 1))]


def report_gates(scored, settled, strata, seed=SEED, raw=None, round_number=None):
    for group in GROUPS:
        result = gates(scored, settled, strata, group)
        holds = result["promise"] is not None and result["promise"] >= PROMISE_LINE
        print(f"{group} promises: {share(result['hits'], result['total'])}; "
              f"{'HOLDS' if holds else 'FAILS'} (>= {PROMISE_LINE:.0%})")
        interval = bootstrap(scored, settled, strata, group, seed)
        reach = result["reach"]
        figure = "none judged" if reach is None else f"{reach:.1%}"
        if interval:
            figure += f" (95% bootstrap {interval[0]:.1%}-{interval[1]:.1%})"
        legacy = not any(row["group"] == group and row["stratum"] == "eligible-other" for row in strata)
        if legacy:
            figure += " (legacy estimator: promises precision for every source; not comparable with round baselines)"
        target = REACH_TARGETS[group]
        met = reach is not None and reach >= target
        baseline = REACH_BASELINE[group]
        reach_holds = (reach is not None and baseline is not None and
                       reach + 1e-9 >= baseline - REACH_TOLERANCE)
        if round_number is None:
            status = "not a round: baseline not applied"
        elif round_number == 0:
            status = "unassessed (this round sets the baseline)"
        elif baseline is None:
            status = "FAILS (baseline not set)"
        else:
            status = (f"{'HOLDS' if reach_holds else 'FAILS'} "
                      f"(>= baseline {baseline:.1%} - {REACH_TOLERANCE:.0%})")
        print(f"{group} reach: {figure}; target {target:.0%}, {'met' if met else 'not met'} "
              f"(not deciding); gate 2: {status}")
        if round_number == 0:
            print(f"{group} overall: unassessed (this round sets the baseline)")
        elif round_number is not None:
            print(f"{group} overall: {'HOLDS' if holds and reach_holds else 'FAILS'} (both gates)")
        if raw is not None:
            result = gates(scored, raw, strata, group)
            reach = "none judged" if result["reach"] is None else f"{result['reach']:.1%}"
            print(f"  labeller raw promises: {share(result['hits'], result['total'])}; reach: {reach}")


def score(directory, sample, labelled, seed=SEED, round_number=None):
    scored = items(sample, labelled)
    differing = [id for id, item in scored.items() if item["answer"] != item["rule"]]
    disagreements = directory / "disagreements"
    disagreements.mkdir(exist_ok=True)
    sides_path = disagreements / "sides.json"
    sides = json.loads(sides_path.read_text()) if sides_path.exists() else {}
    seen = blocks(directory)
    adjudicate(disagreements, "batch", differing,
               {id: seen[item["vacancy"]] for id, item in scored.items()},
               {id: (scored[id]["rule"], scored[id]["answer"]) for id in differing},
               sides, "rule", seed, scored)
    sides_path.write_text(json.dumps(sides, indent=1) + "\n", encoding="utf-8")
    judged = verdicts(disagreements, "batch", sides, "rule")
    missing = set(differing) - judged.keys()
    if missing:
        print(f"{len(differing)} disagreements; {len(missing)} still need adjudicator .verdicts.json files in {disagreements}")
        return False
    settled = {id: item["rule"] for id, item in scored.items()}
    winners = {}
    for id in differing:
        verdict = judged[id]["verdict"]
        winner = "neither" if verdict == "neither" else "rule" if verdict == sides[id]["rule"] else "labeller"
        winners[id] = winner
        if winner == "labeller":
            settled[id] = scored[id]["answer"]
        elif winner == "neither":
            settled[id] = "not eligible" if scored[id]["stratum"] in ("promise", "eligible-other") else "not open"
    report_gates(scored, settled, rows(directory / "strata.tsv"), seed,
                 raw={id: item["answer"] for id, item in scored.items()}, round_number=round_number)
    for group in GROUPS:
        for stratum in STRATA:
            counts = Counter(winners[id] for id in differing
                             if scored[id]["group"] == group and scored[id]["stratum"] == stratum)
            print(f"  {group} {stratum} adjudication: " +
                  ", ".join(f"{who} {counts[who]}" for who in ("rule", "labeller", "neither")))
    patterns = defaultdict(list)
    for id in differing:
        patterns[judged[id].get("pattern", "")].append(id)
    print("Adjudication patterns:")
    for pattern, ids in sorted(patterns.items()):
        print(f"  {pattern or '-'}: {len(ids)}")
        for id in ids:
            item = scored[id]
            print(f"    {id} {item['group']} {item['stratum']}: rule {item['rule']}; labeller {item['answer']}; "
                  f"reason {labelled[item['vacancy']]['reason']}; {winners[id]} [{judged[id].get('clause', '')}]")
    return True


def main():
    if len(sys.argv) not in (2, 3) or not sys.argv[1].isdigit():
        sys.exit(__doc__)
    number = int(sys.argv[1])
    name = f"eligibility-round-{number}" + (f"-{sys.argv[2]}" if len(sys.argv) == 3 else "")
    directory = MEASUREMENTS / name
    if not (directory / "sample.tsv").exists():
        current = str(revision())
        store = kept()
        draw(directory, sampler.vacancies(), SEED + number,
             kept=lambda text: store.get((digest(text), current)))
        (directory / "revision.txt").write_text(current + "\n", encoding="utf-8")
    current = (directory / "revision.txt").read_text().strip()
    missing = [path for path in sorted(directory.glob("batch-*.txt"))
               if not (directory / f"labels-{path.stem[6:]}.tsv").exists()]
    if missing:
        print(f"Label with the eligibility-labeller agent under revision {current}:")
        for path in missing:
            print(f"  {path} -> {directory / f'labels-{path.stem[6:]}.tsv'}")
        return
    sample = rows(directory / "sample.tsv")
    labelled = labels(directory, sample, directory / "same.tsv")
    keep(directory, current)
    out = io.StringIO()
    with redirect_stdout(out):
        complete = score(directory, sample, labelled, SEED + number, round_number=number)
    if complete:
        commit = subprocess.run(["git", "-C", str(REPO), "rev-parse", "--short", "HEAD"],
                                capture_output=True, text=True, check=True).stdout.strip()
        report = f"#103 eligibility round {number}, commit {commit}, criterion revision {current}\n\n" + out.getvalue()
        archive = MEASUREMENTS / f"{name}.txt"
        archive.write_text(report, encoding="utf-8")
        print(report, end="")
        print(f"wrote {archive}")
    else:
        print(out.getvalue(), end="")


if __name__ == "__main__":
    main()
