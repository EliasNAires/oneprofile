#!/usr/bin/env python3
"""Scores the blind sample of candidate pairs that sets the vacancy-group threshold (#27).

    scripts/score-duplicate-sample DIRECTORY

DIRECTORY is where scripts/draw-duplicate-sample drew the sample. Reads each pair's stratum, half, merge level
and inclusion probability from sample.tsv, each drawn vacancy's merges at each threshold from degrees.tsv, and
the labeller's answers from labels-N.tsv (pair, answer, reason, as docs/duplicate-criterion.md says). A pair
is right to merge where it is labelled a duplicate or the same group; an unclear pair is left out of every
share. At a threshold t the pass merges a pair exactly when its merge level is at least t.

For each threshold, and each half apart, prints:

- precision by vacancy, the gate: among the merged pairs, the share right, each pair weighted by its inverse
  inclusion probability times the mean of 1/d over its two vacancies, d being how many pairs of its bucket the
  vacancy is merged in at t. So each merged vacancy counts once, as the share of its merges that are right,
  whatever the size of its bucket. With a 95% Wilson interval on the Kish effective n of the weights;
- precision by pair, each pair weighted by its inverse inclusion probability alone;
- recall by pair, over both halves: among the pairs right to merge, the share merged, the frame's pairs
  (which the pass never compares) included.

Then chooses the lowest threshold whose calibration precision by vacancy reaches BAR, gates it on the
held-out half, and prints the answers by stratum and every merged pair labelled a different position at the
chosen threshold.
"""

import math
import sys
from collections import Counter, defaultdict
from pathlib import Path

Z = 1.96

BAR = 0.95

RIGHT = ("duplicate", "same group")

ANSWERS = RIGHT + ("different position", "unclear")


def rows(path):
    with open(path, encoding="utf-8") as tsv:
        header = tsv.readline().rstrip("\n").split("\t")
        return [dict(zip(header, line.rstrip("\n").split("\t"))) for line in tsv if line.strip()]


def answer(text):
    """A label as one of ANSWERS, or None where it is none of them."""
    said = " ".join(text.strip().lower().replace("_", " ").split())
    return said if said in ANSWERS else None


def merged(pair, threshold):
    """Whether the pass merges the pair at a positive threshold."""
    return pair["level"] > 0 and pair["level"] >= threshold


def pair_weight(pair, threshold=None, degrees=None):
    return 1 / pair["inclusion"]


def vacancy_weight(pair, threshold, degrees):
    """A merged pair's weight when each merged vacancy counts once."""
    share = (1 / degrees[pair["a"]][threshold] + 1 / degrees[pair["b"]][threshold]) / 2
    return share / pair["inclusion"]


def kish(weights):
    """The effective number of observations of unequal weights."""
    return sum(weights) ** 2 / sum(weight * weight for weight in weights)


def precision(pairs, threshold, weight, degrees=None):
    """The weighted share right among the merged pairs, and its Kish effective n; None where none is merged."""
    held = [(weight(pair, threshold, degrees), pair["right"]) for pair in pairs if merged(pair, threshold)]
    if not held:
        return None
    weights = [w for w, _ in held]
    return sum(w for w, right in held if right) / sum(weights), kish(weights)


def recall(pairs, threshold):
    """The share merged among the pairs right to merge, weighted by inverse inclusion."""
    right = [pair for pair in pairs if pair["right"]]
    total = sum(pair_weight(pair) for pair in right)
    return sum(pair_weight(pair) for pair in right if merged(pair, threshold)) / total if total else None


def wilson(share, n):
    centre = (share + Z * Z / (2 * n)) / (1 + Z * Z / n)
    half = Z * math.sqrt(share * (1 - share) / n + Z * Z / (4 * n * n)) / (1 + Z * Z / n)
    return centre - half, centre + half


def choose(shares):
    """The lowest threshold whose share reaches BAR, or None."""
    return next((threshold for threshold, share in sorted(shares.items()) if share is not None and share >= BAR),
                None)


def shown(estimate):
    if estimate is None:
        return f"{'none merged':>26}"
    share, n = estimate
    low, high = wilson(share, n)
    return f"{share:6.1%} ({low:4.0%} to {high:4.0%}, n {n:5.1f})"


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    directory = Path(sys.argv[1])
    sample = rows(directory / "sample.tsv")
    labels = {row["pair"]: row for path in sorted(directory.glob("labels-*.tsv")) for row in rows(path)}
    missing = [row["pair"] for row in sample if row["pair"] not in labels]
    if missing:
        sys.exit(f"{len(missing)} pairs lack a label, as {missing[:5]}")
    degree_rows = rows(directory / "degrees.tsv")
    grid = [float(column) for column in degree_rows[0] if column != "vacancy"]
    degrees = {row["vacancy"]: {threshold: int(row[str(threshold)]) for threshold in grid} for row in degree_rows}

    malformed = [row["pair"] for row in sample if answer(labels[row["pair"]]["answer"]) is None]
    if malformed:
        sys.exit(f"{len(malformed)} pairs have an answer the criterion does not give, as {malformed[:5]}")
    pairs = []
    for row in sample:
        said = answer(labels[row["pair"]]["answer"])
        pairs.append({**row, "level": float(row["level"]), "overlap": float(row["overlap"]),
                      "inclusion": float(row["inclusion"]), "answer": said, "right": said in RIGHT,
                      "reason": labels[row["pair"]].get("reason", "")})
    judged = [pair for pair in pairs if pair["answer"] != "unclear"]
    halves = {half: [pair for pair in judged if pair["half"] == half] for half in ("calibration", "held-out")}

    print(f"labelled {len(pairs)}, unclear {len(pairs) - len(judged)}")
    print("\nanswers by stratum (duplicate, same group, different position, unclear)")
    by_stratum = defaultdict(Counter)
    for pair in pairs:
        by_stratum[pair["stratum"]][pair["answer"]] += 1
    for stratum, said in by_stratum.items():
        print(f"  {stratum:8} " + "  ".join(f"{said[name]:3}" for name in ANSWERS))

    print("\nthreshold  calibration by vacancy               held-out by vacancy                  "
          "held-out by pair                     recall")
    calibration = {}
    for threshold in grid:
        found = {half: precision(held, threshold, vacancy_weight, degrees) for half, held in halves.items()}
        calibration[threshold] = found["calibration"][0] if found["calibration"] else None
        by_pair = precision(halves["held-out"], threshold, pair_weight)
        found_recall = recall(judged, threshold)
        print(f"  {threshold:4}     {shown(found['calibration'])}   {shown(found['held-out'])}   {shown(by_pair)}"
              f"   " + (f"{found_recall:6.1%}" if found_recall is not None else "  none right"))

    chosen = choose(calibration)
    if chosen is None:
        print(f"\nno threshold reaches {BAR:.0%} on the calibration half")
        return
    held = precision(halves["held-out"], chosen, vacancy_weight, degrees)
    passed = held is not None and held[0] >= BAR
    print(f"\nchosen {chosen}: calibration {calibration[chosen]:.1%}, held-out {shown(held)}: "
          + ("passes" if passed else "fails") + f" the {BAR:.0%} gate")

    frame = [pair for pair in judged if pair["stratum"] == "frame"]
    if frame:
        print(f"frame pairs the bucket keeps apart that are one position: {sum(p['right'] for p in frame)}"
              f" of {len(frame)}")
    print(f"\nmerged at {chosen} and labelled a different position")
    for pair in sorted(judged, key=lambda pair: -pair["level"]):
        if merged(pair, chosen) and not pair["right"]:
            print(f"  {pair['pair']:>3}  {pair['half']:11} {pair['level']:.3f} {pair['overlap']:.3f}  {pair['slug']}"
                  f"  {pair['reason']}")


if __name__ == "__main__":
    main()
