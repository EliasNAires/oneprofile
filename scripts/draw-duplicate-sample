#!/usr/bin/env python3
"""Draws the blind sample of candidate pairs that sets the vacancy-group threshold (#27) from the development
database.

    scripts/draw-duplicate-sample PAIRS.tsv DIRECTORY

PAIRS.tsv is scripts/VacancyGroupPairs.java's output: every candidate pair, two vacancies of one slug with the
same normalized titles, with whether they share the pass's bucket, their merge level and their overlap.

Each pair falls in one stratum: `frame` where the two do not share the pass's bucket (the pass never merges
them), `level 0` where they share it but nothing joins them, and otherwise a band of merge levels (STRATA). A
few companies hold most pairs (one bucket of n vacancies holds n(n-1)/2), so a stratum is not drawn by pair:
a vacancy of the stratum is drawn at random, then one of its pairs in the stratum, until the stratum's size
(STRATA) is reached. A pair (a, b) is drawn with probability about n (1/d_a + 1/d_b) / V, n the pairs drawn,
V the stratum's vacancies and d a vacancy's pairs in it. Each stratum's pairs are then split at random in
halves: calibration, where the threshold is chosen, and held-out, where it is gated.

Writes DIRECTORY/strata.tsv, each stratum's pairs, vacancies and pairs drawn; DIRECTORY/sample.tsv, every
drawn pair with its stratum, half, slug, vacancies, ATSs, level, overlap and inclusion probability;
DIRECTORY/degrees.tsv, for each drawn vacancy, how many pairs of its bucket single linkage joins it to at each
threshold of GRID, which weighs a merge by vacancy rather than by pair (scripts/score-duplicate-sample); and
DIRECTORY/batch-N.txt, the pairs shuffled in batches of BATCH with only what a labeller sees
(docs/duplicate-criterion.md): a block per pair, headed `=== N`, with the two vacancies as A and B in a random
order, each with its company, title, locations, work modes and description segments.
"""

import csv
import json
import random
import subprocess
import sys
from collections import defaultdict
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent

SEED = 27

BATCH = 20

# The strata, as (name, lowest merge level, level the stratum stops below, pairs drawn): denser where the
# threshold is likely to fall. `frame` and `level 0` are not bands of levels; their bounds are unused.
STRATA = [("frame", None, None, 20), ("level 0", 0, 0, 10), ("<0.2", 0, 0.2, 20), ("0.2-0.4", 0.2, 0.4, 24),
          ("0.4-0.6", 0.4, 0.6, 30), ("0.6-0.7", 0.6, 0.7, 36), ("0.7-0.8", 0.7, 0.8, 40),
          ("0.8-0.9", 0.8, 0.9, 40), ("0.9-1", 0.9, 1, 40), ("1.0", 1, 2, 40)]

# The thresholds a merge is scored at; all positive, the only ones a merge level holds for.
GRID = (0.3, 0.4, 0.5, 0.55, 0.6, 0.65, 0.7, 0.75, 0.8, 0.85, 0.9, 0.95, 1.0)

VACANCIES = """
copy (
  select n.vacancy_id, coalesce(c.name, c.slug), v.title, array_to_string(n.work_modes, ','),
    n.description_segments,
    (select json_agg(l.location order by case l.list when 'LOCATION' then 0 when 'SECONDARY_LOCATIONS' then 1
       else 2 end, l.position) from normalized_vacancy_location l where l.normalized_vacancy_id = n.id)
  from normalized_vacancy n join vacancy v on v.id = n.vacancy_id join company c on c.id = v.company_id
  where n.vacancy_id in ({ids})
) to stdout with (format csv, header false)
"""


def psql(query):
    out = subprocess.run(["docker", "compose", "--project-directory", str(REPO), "exec", "-T", "postgres", "psql",
                          "-v", "ON_ERROR_STOP=1", "-U", "oneprofile", "-d", "oneprofile", "-c", query],
                         capture_output=True, text=True, encoding="utf-8", check=True).stdout
    return list(csv.reader(out.splitlines(keepends=True)))


def stratum(same, level):
    """The stratum of a pair, by whether it shares the pass's bucket and its merge level."""
    if not same:
        return "frame"
    if level == 0:
        return "level 0"
    return next(name for name, low, high, _ in STRATA[2:] if low <= level < high)


def read(path):
    """Every candidate pair, as a dict with its stratum."""
    pairs = []
    with open(path, encoding="utf-8") as tsv:
        for line in tsv:
            slug, a, b, ats_a, ats_b, same, level, overlap = line.rstrip("\n").split("\t")
            pairs.append({"slug": slug, "a": a, "b": b, "ats_a": ats_a, "ats_b": ats_b, "same": same == "1",
                          "level": float(level), "overlap": float(overlap),
                          "stratum": stratum(same == "1", float(level))})
    return pairs


def draw(pairs, rng):
    """Draws each stratum's pairs vacancy first, as the module's docstring says.
    Returns the drawn pairs with their inclusion probability, and each stratum's pairs and vacancies."""
    by_stratum = defaultdict(lambda: defaultdict(list))
    for index, pair in enumerate(pairs):
        by_stratum[pair["stratum"]][pair["a"]].append(index)
        by_stratum[pair["stratum"]][pair["b"]].append(index)
    drawn = []
    strata = []
    for name, _, _, size in STRATA:
        indices_by_vacancy = by_stratum.get(name, {})
        vacancies = sorted(indices_by_vacancy, key=int)
        total = len({index for indices in indices_by_vacancy.values() for index in indices})
        size = min(size, total)
        chosen = []
        taken = set()
        while len(chosen) < size:
            index = rng.choice(indices_by_vacancy[rng.choice(vacancies)])
            if index not in taken:
                taken.add(index)
                chosen.append(index)
        for index in chosen:
            pair = pairs[index]
            share = (1 / len(indices_by_vacancy[pair["a"]]) + 1 / len(indices_by_vacancy[pair["b"]])) / len(vacancies)
            drawn.append(dict(pair, inclusion=min(1.0, size * share)))
        strata.append((name, total, len(vacancies), size))
    return drawn, strata


def split(drawn, rng):
    """Splits each stratum's drawn pairs at random into calibration and held-out halves."""
    for name in dict.fromkeys(pair["stratum"] for pair in drawn):
        stratum_pairs = [pair for pair in drawn if pair["stratum"] == name]
        rng.shuffle(stratum_pairs)
        for position, pair in enumerate(stratum_pairs):
            pair["half"] = "calibration" if position < (len(stratum_pairs) + 1) // 2 else "held-out"


def degrees(pairs, vacancies):
    """For each vacancy, how many pairs of its bucket have a merge level of at least each threshold of GRID."""
    found = {vacancy: [0] * len(GRID) for vacancy in vacancies}
    for pair in pairs:
        if not pair["same"]:
            continue
        for vacancy in (pair["a"], pair["b"]):
            if vacancy in found:
                for position, threshold in enumerate(GRID):
                    if pair["level"] >= threshold:
                        found[vacancy][position] += 1
    return found


def flat(text):
    return " ".join((text or "-").split())


def marked(segment):
    text = flat(segment["text"])
    if segment.get("kind") == "HEADING":
        text = "# " + text
    elif segment.get("kind") == "ITEM":
        text = "- " + text
    return "> " + text if segment.get("boilerplate") else text


def shown(vacancy):
    return (f"company: {flat(vacancy['company'])}\ntitle: {flat(vacancy['title'])}\n"
            f"locations: {' | '.join(flat(location) for location in vacancy['locations']) or '-'}\n"
            f"work modes: {vacancy['modes'].lower().replace(',', ', ') or '-'}\ndescription:\n"
            + ("\n".join(marked(segment) for segment in vacancy["segments"]) or "-") + "\n")


def vacancies_of(ids):
    found = {}
    ids = sorted(ids, key=int)
    for start in range(0, len(ids), 500):
        for r in psql(VACANCIES.format(ids=",".join(ids[start:start + 500]))):
            found[r[0]] = {"company": r[1], "title": r[2], "modes": r[3],
                           "segments": json.loads(r[4]) if r[4] else [], "locations": json.loads(r[5]) if r[5] else []}
    return found


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    directory = Path(sys.argv[2])
    directory.mkdir(parents=True, exist_ok=True)
    print("Reading the pairs", file=sys.stderr)
    pairs = read(sys.argv[1])
    rng = random.Random(SEED)
    drawn, strata = draw(pairs, rng)
    split(drawn, rng)
    for number, pair in enumerate(drawn, 1):
        pair["pair"] = str(number)

    with open(directory / "strata.tsv", "w", encoding="utf-8") as out:
        out.write("stratum\tpairs\tvacancies\tdrawn\n")
        for name, total, vacancies, size in strata:
            out.write(f"{name}\t{total}\t{vacancies}\t{size}\n")
    with open(directory / "sample.tsv", "w", encoding="utf-8") as out:
        out.write("pair\tstratum\thalf\tslug\ta\tb\tats_a\tats_b\tlevel\toverlap\tinclusion\n")
        for pair in drawn:
            out.write("\t".join([pair["pair"], pair["stratum"], pair["half"], pair["slug"], pair["a"], pair["b"],
                                 pair["ats_a"], pair["ats_b"], repr(pair["level"]), repr(pair["overlap"]),
                                 repr(pair["inclusion"])]) + "\n")
    ids = {vacancy for pair in drawn for vacancy in (pair["a"], pair["b"])}
    print("Counting each drawn vacancy's merges", file=sys.stderr)
    with open(directory / "degrees.tsv", "w", encoding="utf-8") as out:
        out.write("vacancy\t" + "\t".join(str(threshold) for threshold in GRID) + "\n")
        for vacancy, counts in sorted(degrees(pairs, ids).items(), key=lambda item: int(item[0])):
            out.write(vacancy + "\t" + "\t".join(map(str, counts)) + "\n")

    print("Reading the drawn vacancies", file=sys.stderr)
    vacancies = vacancies_of(ids)
    order = list(drawn)
    rng.shuffle(order)
    for number, start in enumerate(range(0, len(order), BATCH), 1):
        blocks = []
        for pair in order[start:start + BATCH]:
            first, second = (pair["a"], pair["b"]) if rng.random() < 0.5 else (pair["b"], pair["a"])
            blocks.append(f"=== {pair['pair']}\n--- A\n{shown(vacancies[first])}--- B\n{shown(vacancies[second])}\n")
        body = "".join(blocks)
        (directory / f"batch-{number}.txt").write_text(body, encoding="utf-8")
        print(f"batch-{number}.txt: {len(blocks)} pairs, {len(body.encode()) / 1024:.1f} KB")
    print(f"{len(drawn)} pairs drawn")


if __name__ == "__main__":
    main()
