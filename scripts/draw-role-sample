#!/usr/bin/env python3
"""Draws step 6's blind sample of the role assignment (#25) from the development database.

    scripts/draw-role-sample DIRECTORY [per role, default 11]

Run after POST /roles. For each role, draws that many vacancies the rule gives it, spread over the ATSs
in proportion to the role's vacancies on each; a vacancy with two roles can be drawn under either. Then
tops up the bare heads (a normalized title that is only a head the role list gives a role alone, such
as `engineer`) to 5 per ATS, so the sample can report them by ATS. The draw is seeded.

Writes DIRECTORY/sample.tsv, every drawn vacancy with its ATS, its normalized titles, the role it was
drawn under, the rule's roles and whether its titles are all on 1 to 4 vacancies (the tail); and
DIRECTORY/batch-1.tsv and batch-2.tsv, the same vacancies shuffled and split in two, with only what a
labeller sees: an id, the company and the raw title.
"""

import csv
import random
import subprocess
import sys
from collections import Counter
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent

SEED = 25

BATCHES = 2

BARE_PER_ATS = 5

QUERY = """
copy (
  select v.id, v.ats, coalesce(c.name, c.slug), v.title, array_to_string(n.normalized_titles, '|'),
    array_to_string(n.roles, '|')
  from normalized_vacancy n join vacancy v on v.id = n.vacancy_id join company c on c.id = v.company_id
  where n.roles is not null
) to stdout with (format csv, header false)
"""


def vacancies():
    out = subprocess.run(["docker", "compose", "--project-directory", str(REPO), "exec", "-T", "postgres", "psql",
                          "-v", "ON_ERROR_STOP=1", "-U", "oneprofile", "-d", "oneprofile", "-c", QUERY],
                         capture_output=True, text=True, encoding="utf-8", check=True).stdout
    return [{"id": r[0], "ats": r[1], "company": r[2], "title": r[3],
             "normalized": [t for t in r[4].split("|") if t], "roles": [t for t in r[5].split("|") if t]}
            for r in csv.reader(out.splitlines())]


def bare_heads():
    """The heads the role list gives a role when nothing stands in front of them."""
    with open(REPO / "src/main/resources/rolelist/words.tsv", encoding="utf-8") as tsv:
        lines = [line.rstrip("\n").split("\t") for line in tsv][1:]
    return {phrase for phrase, use, _, role in lines if use == "head" and role not in ("", "none")}


def spread(count, shares):
    """Splits a count over the keys in proportion to their shares, by largest remainder."""
    total = sum(shares.values())
    exact = {key: count * share / total for key, share in shares.items()}
    counts = {key: int(value) for key, value in exact.items()}
    for key in sorted(exact, key=lambda key: exact[key] - counts[key], reverse=True)[:count - sum(counts.values())]:
        counts[key] += 1
    return counts


def main():
    if not 2 <= len(sys.argv) <= 3:
        sys.exit(__doc__)
    directory = Path(sys.argv[1])
    per_role = int(sys.argv[2]) if len(sys.argv) == 3 else 11
    directory.mkdir(parents=True, exist_ok=True)
    rows = vacancies()
    carried = Counter(title for row in rows for title in row["normalized"])
    generator = random.Random(SEED)

    drawn = {}
    for role in sorted({role for row in rows for role in row["roles"]}):
        holding = [row for row in rows if role in row["roles"] and row["id"] not in drawn]
        by_ats = {}
        for row in holding:
            by_ats.setdefault(row["ats"], []).append(row)
        for ats, count in spread(per_role, {ats: len(held) for ats, held in by_ats.items()}).items():
            for row in generator.sample(by_ats[ats], count):
                drawn[row["id"]] = {**row, "drawn": role}

    bare = bare_heads()
    for ats in sorted({row["ats"] for row in rows}):
        have = sum(1 for row in drawn.values() if row["ats"] == ats and len(row["normalized"]) == 1
                   and row["normalized"][0] in bare)
        pool = [row for row in rows if row["ats"] == ats and row["id"] not in drawn and len(row["normalized"]) == 1
                and row["normalized"][0] in bare]
        for row in generator.sample(pool, max(0, min(BARE_PER_ATS - have, len(pool)))):
            drawn[row["id"]] = {**row, "drawn": "bare"}

    sample = sorted(drawn.values(), key=lambda row: (row["drawn"], row["ats"], row["id"]))
    with open(directory / "sample.tsv", "w", encoding="utf-8") as out:
        out.write("id\tats\tdrawn\troles\ttail\tnormalized\ttitle\n")
        for row in sample:
            tail = all(carried[title] < 5 for title in row["normalized"])
            out.write("\t".join([row["id"], row["ats"], row["drawn"], ",".join(row["roles"]) or "none",
                                 "yes" if tail else "no", " | ".join(row["normalized"]),
                                 " ".join(row["title"].split())]) + "\n")
    shuffled = sample[:]
    generator.shuffle(shuffled)
    size = -(-len(shuffled) // BATCHES)
    for batch in range(BATCHES):
        with open(directory / f"batch-{batch + 1}.tsv", "w", encoding="utf-8") as out:
            out.write("id\tcompany\ttitle\n")
            for row in shuffled[batch * size:(batch + 1) * size]:
                out.write("\t".join([row["id"], " ".join(row["company"].split()), " ".join(row["title"].split())])
                          + "\n")
    print(f"{len(sample)} vacancies drawn, {sum(row['drawn'] == 'bare' for row in sample)} of them bare heads"
          f" topped up")


if __name__ == "__main__":
    main()
