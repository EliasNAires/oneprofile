#!/usr/bin/env python3
"""Checks the eligibility labeller and adjudicator against the gold set (#103, ADR-0029).

    scripts/check-eligibility-gold

Works in docs/measurements/eligibility-gold-check-revision-<R>/, R the highest criterion revision.
Missing labels-N.tsv prompt eligibility-labeller to label eligibility-gold/batch-N.txt into the check.
Once every batch is labelled, each row in same.tsv takes its twin's label. Every gold row must carry
its gold label. Reports agreement and Wilson 95% intervals per part and stratum. Disagreements go
unattributed to open-batch-NNN.json and held-batch-NNN.json in batches of 20; sides.json records the
gold and labeller sides. The open rows also go into open-disagreements.tsv (id, stratum, gold,
labeller, reason, doubt). No batch files are rewritten once any exist for that part.

The adjudicator supplies matching .verdicts.json files ({id: {verdict: a|b|neither, clause, pattern}}).
Subsequent runs report per part how often it chose gold, labeller or neither. Held-out rows' ids,
texts and labels are never printed, including when labels are missing or invalid: counts only.
No kept-label store is used or written.
"""

import json
import sys
from collections import Counter
from importlib.machinery import SourceFileLoader
from pathlib import Path

sys.dont_write_bytecode = True
SCRIPTS = Path(__file__).resolve().parent
round = SourceFileLoader("eligibility_round", str(SCRIPTS / "score-eligibility-round")).load_module()
REPO = round.REPO
MEASUREMENTS = round.MEASUREMENTS
GOLD = MEASUREMENTS / "eligibility-gold-set.tsv"
BATCHES = MEASUREMENTS / "eligibility-gold"
CHECK = MEASUREMENTS / "eligibility-gold-check-revision-{revision}"


def main():
    current = round.revision()
    directory = Path(str(CHECK).format(revision=current))
    directory.mkdir(parents=True, exist_ok=True)
    missing = [path for path in sorted(BATCHES.glob("batch-*.txt"))
               if not (directory / f"labels-{path.stem[6:]}.tsv").exists()]
    if missing:
        print(f"Label with the eligibility-labeller agent under revision {current}:")
        for path in missing:
            print(f"  {path} -> {directory / f'labels-{path.stem[6:]}.tsv'}")
        return
    gold = round.rows(GOLD)
    if any(not row["label"].strip() for row in gold):
        sys.exit(f"{sum(not row['label'].strip() for row in gold)} gold rows have no label yet")
    for row in gold:
        allowed = ("eligible", "excluded", "unknown") if row["stratum"] == "promise" else ("open", "closed", "unclear")
        if row["label"] not in allowed:
            sys.exit("Invalid gold label for a stratum")
    labels = round.labels(directory, gold, BATCHES / "same.tsv")
    seen = round.blocks(BATCHES)
    sides_path = directory / "sides.json"
    sides = json.loads(sides_path.read_text(encoding="utf-8")) if sides_path.exists() else {}
    print(f"Gold set check at criterion revision {current}")
    for part in ("open", "held-out"):
        members = [row for row in gold if row["part"] == part]
        differing = [row for row in members if labels[row["id"]]["verdict"] != row["label"]]
        print(f"\n{part} ({len(members)} rows):")
        print(f"  labeller agreement: {round.share(len(members) - len(differing), len(members))}")
        for stratum in ("promise", "unknown"):
            held = [row for row in members if row["stratum"] == stratum]
            hits = sum(labels[row["id"]]["verdict"] == row["label"] for row in held)
            print(f"  {stratum}: {round.share(hits, len(held))}")
        prefix = "open-batch" if part == "open" else "held-batch"
        if part == "open":
            round.write_rows(directory / "open-disagreements.tsv",
                             ["id", "stratum", "gold", "labeller", "reason", "doubt"],
                             ([row["id"], row["stratum"], row["label"], labels[row["id"]]["verdict"],
                               labels[row["id"]]["reason"], row["doubt"]] for row in differing))
        ids = [row["id"] for row in differing]
        round.adjudicate(directory, prefix, ids, seen,
                         {row["id"]: (row["label"], labels[row["id"]]["verdict"]) for row in differing},
                         sides, "gold")
        judged = round.verdicts(directory, prefix, sides, "gold")
        print(f"  {len(differing)} disagreements in {len(round.batches(directory, prefix))} batches, "
              f"{len(judged)} adjudicated")
        if judged:
            counts = Counter("neither" if row["verdict"] == "neither" else
                             "gold" if row["verdict"] == sides[id]["gold"] else "labeller"
                             for id, row in judged.items())
            print("  adjudicator: " + "; ".join(f"{who} {round.share(counts[who], len(judged))}"
                                               for who in ("gold", "labeller", "neither")))
    sides_path.write_text(json.dumps(sides, indent=1) + "\n", encoding="utf-8")


if __name__ == "__main__":
    main()
