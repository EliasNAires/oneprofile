#!/usr/bin/env python3
"""Checks the eligibility labeller and adjudicator against the group gold set (#103, ADR-0031).

    scripts/check-eligibility-gold

Works in docs/measurements/eligibility-gold-groups-check-revision-<R>/, R the highest criterion revision.
Missing labels-N.tsv prompt eligibility-labeller to label eligibility-gold-groups/batch-N.txt into
this check. Each row in same.tsv takes its twin's labels. Every gold row must carry all six verdicts.
Reports scored agreement per part and group, and exact agreement on all six verdicts, with Wilson
95% intervals. Disagreements go unattributed to open-batch-NNN.json and held-batch-NNN.json, 20 items
a batch; sides.json records gold and labeller sides. Open items also go into open-disagreements.tsv
(id, group, stratum, gold, labeller, reason, doubt). Existing adjudication batches are preserved.

The adjudicator supplies matching .verdicts.json files ({id: {verdict: a|b|neither, clause, pattern}}).
Subsequent runs report per part how often it chose gold, labeller or neither. The gold labels as
settled answers also measure each group's promises and reach at the rules as they stand, using strata.tsv.
Held-out rows' ids, texts and labels are never printed, including failures: counts and figures only.
No kept-label store is used or written.
"""

import json
import sys
from collections import Counter
from importlib.machinery import SourceFileLoader
from pathlib import Path

sys.dont_write_bytecode = True
SCRIPTS = Path(__file__).resolve().parent
round = SourceFileLoader("eligibility_round", str(SCRIPTS / "score-eligibility-round")).load_module()
REPO = round.REPO
MEASUREMENTS = round.MEASUREMENTS
GOLD = MEASUREMENTS / "eligibility-gold-set-groups.tsv"
BATCHES = MEASUREMENTS / "eligibility-gold-groups"
CHECK = MEASUREMENTS / "eligibility-gold-groups-check-revision-{revision}"


def scored_answer(item):
    if item["stratum"] == "promise":
        return "eligible" if item["answer"] == "eligible" else "not eligible"
    return item["answer"]


def main():
    current = round.revision()
    directory = Path(str(CHECK).format(revision=current))
    directory.mkdir(parents=True, exist_ok=True)
    missing = [path for path in sorted(BATCHES.glob("batch-*.txt"))
               if not (directory / f"labels-{path.stem[6:]}.tsv").exists()]
    if missing:
        print(f"Label with the eligibility-labeller agent under revision {current}:")
        for path in missing:
            print(f"  {path} -> {directory / f'labels-{path.stem[6:]}.tsv'}")
        return
    gold = round.rows(GOLD)
    round.validate_labels(gold, "gold")
    labelled = round.labels(directory, gold, BATCHES / "same.tsv")
    gold_items = round.items(gold, {row["id"]: row for row in gold})
    labeller_items = round.items(gold, labelled)
    gold_answers = {id: scored_answer(item) for id, item in gold_items.items()}
    labeller_answers = {id: scored_answer(item) for id, item in labeller_items.items()}
    seen = round.blocks(BATCHES)
    sides_path = directory / "sides.json"
    sides = json.loads(sides_path.read_text(encoding="utf-8")) if sides_path.exists() else {}
    print(f"Gold set check at criterion revision {current}")
    for part in ("open", "held-out"):
        members = [row for row in gold if row["part"] == part]
        member_ids = {row["id"] for row in members}
        scored = {id: item for id, item in gold_items.items() if item["vacancy"] in member_ids}
        differing = [id for id in scored if gold_answers[id] != labeller_answers[id]]
        print(f"\n{part} ({len(members)} rows):")
        print(f"  scored agreement: {round.share(len(scored) - len(differing), len(scored))}")
        for group in round.GROUPS:
            ids = [id for id, item in scored.items() if item["group"] == group]
            hits = sum(gold_answers[id] == labeller_answers[id] for id in ids)
            print(f"  {group}: {round.share(hits, len(ids))}")
        exact = sum(all(row[column] == labelled[row["id"]][column] for column in round.VERDICTS)
                    for row in members)
        print(f"  exact six-verdict agreement: {round.share(exact, len(members))}")
        prefix = "open-batch" if part == "open" else "held-batch"
        if part == "open":
            by_id = {row["id"]: row for row in members}
            round.write_rows(directory / "open-disagreements.tsv",
                             ["id", "group", "stratum", "gold", "labeller", "reason", "doubt"],
                             ([id, scored[id]["group"], scored[id]["stratum"], gold_answers[id],
                               labeller_answers[id], labelled[scored[id]["vacancy"]]["reason"],
                               by_id[scored[id]["vacancy"]]["doubt"]] for id in differing))
        round.adjudicate(directory, prefix, differing,
                         {id: seen[item["vacancy"]] for id, item in scored.items()},
                         {id: (gold_answers[id], labeller_answers[id]) for id in differing},
                         sides, "gold", items=scored)
        judged = round.verdicts(directory, prefix, sides, "gold")
        print(f"  {len(differing)} disagreements in {len(round.batches(directory, prefix))} batches, "
              f"{len(judged)} adjudicated")
        if judged:
            counts = Counter("neither" if row["verdict"] == "neither" else
                             "gold" if row["verdict"] == sides[id]["gold"] else "labeller"
                             for id, row in judged.items())
            print("  adjudicator: " + "; ".join(f"{who} {round.share(counts[who], len(judged))}"
                                               for who in ("gold", "labeller", "neither")))
    sides_path.write_text(json.dumps(sides, indent=1) + "\n", encoding="utf-8")
    print("\nThe gold set at the rules as they stand:")
    round.report_gates(gold_items, gold_answers, round.rows(BATCHES / "strata.tsv"))


if __name__ == "__main__":
    main()
