#!/usr/bin/env python3
"""Runs skill discovery on a snapshot (ADR-0016, #64): the skill-decider agent decides every candidate
and drafts the row of each it keeps, and a session reviews the decisions into skills.tsv and every
decision into the decision record. docs/taxonomy.md holds the procedure; this is its plumbing.

    scripts/discover-skills batch <candidates.tsv> [<names.txt>]
    scripts/discover-skills decide
    scripts/discover-skills collect
    scripts/discover-skills append

batch reads the candidates scripts/skill_discovery.py wrote, and the names of a file, one a line,
proposed besides them; a name that is a key of skills.tsv is skipped. It writes every candidate a
segment mentions into the run's folder, next to the snapshot, in batches of BATCH sorted by compact
name, each with its spellings, three segments, the skills of skills.tsv it may be a spelling of and
every decision on it in the record. A name no segment mentions cannot be decided, and goes to
unmentioned.txt. Writing the batches again starts a new run: earlier batches, decisions and costs go.

decide runs the agent headless, PARALLEL batches at a time, on each batch whose decisions file lacks
an entry of it, and so carries on where a failed or stopped run left off. A batch the agent leaves an
entry out of is reported, and decided whole again by the next decide; no decision is filled in for
the agent. The cost and tokens of each batch go to costs.tsv, and the run's total is printed.

collect refuses while a batch has an entry left out, and otherwise writes review.tsv from the agent's
decisions: a row per candidate, with its kind, the fields of its skill, the keys it marks context, a
drop's reason and the agent's note, which starts `doubt:` on a decision in doubt. A split adds a `part`
row for each skill it names and a join a `whole` row for the skill its piece belongs to; those rows
name skills, not candidates. Each name no segment mentions is a drop of the session's. The session
reads it across batches for one skill drafted twice, keys that collide and decisions the criterion
does not support, and edits it, marking each row it changes with the source `session`. append writes
it: each spelling or new skill's name joins skills.tsv under its id, each part or whole adds its skill
without the candidate's name, the keys marked context go to the context column, and each candidate's
decision, a split's or join's as a drop, is appended to decisions.tsv.
"""

import csv
import json
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
import skill_discovery  # noqa: E402
import skillloop  # noqa: E402

# The run's working files, next to the snapshot: batches, decisions, costs and the review.
RUN = skillloop.SEGMENTS.parent / f"skill-run-{skillloop.SNAPSHOT}"

EXAMPLES = 3  # segments per candidate, as each round of #54 gave Jev

BATCH = 60  # $0.65-0.92 and 6-9 minutes of Sonnet a batch (docs/measurements/skill-decider-2026-10-18.md)

PARALLEL = 15  # batches decided at once, the account's limit on concurrent agents

CLAUDE = "claude"

COST_COLUMNS = ("batch", "cost_usd", "input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens",
                "output_tokens", "duration_ms")

REVIEW_COLUMNS = ("name", "kind", "source", "id", "canonical", "category", "aliases", "context", "reason", "note")

SOURCE = "skill-decider"


def run_candidates(candidates, names, keys):
    """The run's candidates, those of the discovery script then the names given, once by name form, no
    key of skills.tsv among them. A name given has no document frequency of its own."""
    seen, result = set(keys), []
    for candidate in list(candidates) + [{"name": name, "df": None} for name in names]:
        form = skillloop.name_form(candidate["name"])
        if form not in seen:
            seen.add(form)
            result.append(candidate)
    return result


def compact(name):
    """The name form without its spaces and punctuation, a symbol a name carries (C++, C#) kept."""
    return re.sub(r"[^\w+#]|_", "", skillloop.name_form(name))


def similar(name, keys):
    """The skills of skills.tsv, by canonical name, a name may be a spelling of: one whose key is the
    name written without its spaces or symbols, or with an s; a run of the name's words, three
    characters long at least (Kafka Streams beside Kafka); or one whose key holds the name as a run of
    its words, the name's bare form (Glue beside AWS Glue). Narrows what the agent checks; the agent
    decides."""
    compacts, runs = {}, {}
    for form, canonical in keys.items():
        compacts.setdefault(compact(form), set()).add(canonical)
        for run in word_runs(form):
            runs.setdefault(run, set()).add(canonical)
    found = set()
    for written in {compact(name), re.sub(r"e?s$", "", compact(name))}:
        found |= compacts.get(written, set())
    found |= {keys[run] for run in word_runs(skillloop.name_form(name)) if len(run) >= 3 and run in keys}
    if len(skillloop.name_form(name)) >= 3:
        found |= runs.get(skillloop.name_form(name), set())
    return sorted(found, key=str.lower)


def word_runs(form):
    """Every run of adjacent words of a name form."""
    words = form.split(" ")
    return {" ".join(words[first:last]) for first in range(len(words)) for last in range(first + 1, len(words) + 1)}


# The decision on a candidate's name form each kind records; a part or whole names a skill, not a candidate.
DECISION = {"spelling": "keep", "new": "keep", "drop": "drop", "split": "drop", "join": "drop"}

NAMED = ("part", "whole")


def apply(skills, rows):
    """skills.tsv's rows, as read by skillloop.read_skill_rows, with the reviewed rows applied, and the
    decisions to record as (name form, decision, source), one per candidate. A spelling's or new skill's
    name is a key of the skill its id names, and a split's part or a join's whole adds its skill without
    the candidate's name. A skill under an id skills.tsv lacks takes the canonical name and category of the
    first row giving them. A key the skill holds is not added again, and one another skill holds is
    refused; a key the row marks context is added as one."""
    by_id = {row[0]: (row[0], row[1], row[2], list(row[3]), set(row[4])) for row in skills}
    for row in rows:
        if row["kind"] in ("new", *NAMED) and row["canonical"]:
            if row["id"] in by_id:
                sys.exit(f"{row['name']}: drafts {row['id']!r} anew, which skills.tsv or an earlier row holds")
            if row["category"]:
                by_id[row["id"]] = (row["id"], row["canonical"], row["category"], [], set())
    held = {skillloop.name_form(key): row[0] for row in skills for key in row[3]}
    decisions = []
    for row in rows:
        if row["kind"] not in NAMED:
            decisions.append((skillloop.name_form(row["name"]), DECISION[row["kind"]], row["source"]))
            if DECISION[row["kind"]] != "keep":
                continue
        if row["id"] not in by_id:
            sys.exit(f"{row['name']}: a new id, {row['id']!r}, needs a row with its canonical name and category")
        keys, context = by_id[row["id"]][3:]
        marked = {skillloop.name_form(key) for key in row["context"].split("|") if key}
        own = [] if row["kind"] in NAMED else [row["name"]]
        for key in [by_id[row["id"]][1], *filter(None, row["aliases"].split("|")), *own]:
            form = skillloop.name_form(key)
            if held.setdefault(form, row["id"]) != row["id"]:
                sys.exit(f"{row['name']}: the key {key!r} is a key of {held[form]!r}, not of {row['id']!r}")
            written = next((held_key for held_key in keys if skillloop.name_form(held_key) == form), None)
            if written is None:
                keys.append(written := key)
            if form in marked:
                context.add(written)
    return [by_id[identifier] for identifier in sorted(by_id)], decisions


def write_tsv(path, columns, rows):
    with open(path, "w", newline="") as out:
        writer = csv.writer(out, delimiter="\t", lineterminator="\n", quoting=csv.QUOTE_NONE, escapechar="\\")
        writer.writerow(columns)
        writer.writerows(rows)


def read_tsv(path):
    with open(path, newline="") as lines:
        return list(csv.DictReader(lines, delimiter="\t", quoting=csv.QUOTE_NONE))


def read_record(path=skillloop.DECISIONS):
    """Every decision of the record, by name form, in the order made; skillloop.read_decisions keeps only
    the last."""
    record = {}
    for row in read_tsv(path):
        record.setdefault(row["name"], []).append({k: row[k] for k in ("decision", "revision", "source")})
    return record


def batch_entries(candidates, segments, keys, skill_rows, record):
    """The batch entry of each candidate a segment mentions, sorted by compact name so pieces of one name
    sit together, and the names no segment mentions."""
    by_canonical = {row[1]: row for row in skill_rows}
    entries, unmentioned = [], []
    for c in candidates:
        form = skillloop.name_form(c["name"])
        examples = segments.examples(c["name"], EXAMPLES, f"run-{skillloop.SNAPSHOT}-{form}")
        if not examples:
            unmentioned.append(c["name"])
            continue
        entries.append({"name": c["name"], "df": c["df"] or segments.document_frequency(c["name"]),
                        "spellings": c.get("forms", {}), "segments": [text for _, text in examples],
                        "similar": [{"id": by_canonical[s][0], "canonical": s, "category": by_canonical[s][2],
                                     "keys": by_canonical[s][3]} for s in similar(c["name"], keys)],
                        "record": record.get(form, [])})
    entries.sort(key=lambda e: compact(e["name"]))
    return entries, unmentioned


def write_batches(entries, run, size=BATCH):
    run.mkdir(exist_ok=True)
    for old in [*run.glob("batch-*.json"), run / "costs.tsv"]:
        old.unlink(missing_ok=True)
    for number, start in enumerate(range(0, len(entries), size), 1):
        (run / f"batch-{number:03}.json").write_text(json.dumps(entries[start:start + size], ensure_ascii=False,
                                                                indent=1))


def batch(candidates_path, names_path=None):
    keys = skillloop.read_keys()
    names = [line.strip() for line in open(names_path) if line.strip()] if names_path else []
    candidates = run_candidates(skill_discovery.read_candidates(candidates_path), names, keys)
    entries, unmentioned = batch_entries(candidates, skillloop.read_segments(), keys, skillloop.read_skill_rows(),
                                         read_record())
    write_batches(entries, RUN)
    (RUN / "unmentioned.txt").write_text("".join(f"{name}\n" for name in unmentioned))
    print(f"{len(candidates)} candidates, {len(unmentioned)} mentioned in no segment: {', '.join(unmentioned)}")
    print(f"{len(entries)} in {-(-len(entries) // BATCH)} batches under {RUN}")


def left_out(batch_path):
    """The names of a batch its decisions file has no decision for: all of them while it has none."""
    names = [e["name"] for e in json.loads(batch_path.read_text())]
    try:
        decisions = json.loads(batch_path.with_suffix(".decisions.json").read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return names
    return [name for name in names if name not in decisions]


def decide_batch(batch_path):
    """Runs the agent on one batch, and returns its headless result, or None when it printed none."""
    prompt = f"Decide the batch {batch_path}. The criterion is {skillloop.CRITERION}."
    done = subprocess.run([CLAUDE, "-p", "--agent", "skill-decider", "--model", "sonnet",
                           "--add-dir", str(batch_path.parent), "--tools", "Read,Write", "--strict-mcp-config",
                           "--allowedTools", "Read,Write",
                           "--permission-mode", "acceptEdits", "--output-format", "json", prompt],
                          cwd=skillloop.REPO, capture_output=True, text=True)
    try:
        return json.loads(done.stdout)
    except json.JSONDecodeError:
        print(f"{batch_path.stem}: exit {done.returncode}, no result: {done.stderr.strip()[-500:]}")
        return None


def decide(run=RUN):
    """Decides each batch with an entry left out, and returns the batches still left so, with the names."""
    pending = [path for path in sorted(run.glob("batch-???.json")) if left_out(path)]
    costs = run / "costs.tsv"
    print(f"{len(pending)} batches to decide")
    incomplete = []
    with ThreadPoolExecutor(PARALLEL) as pool:
        futures = {pool.submit(decide_batch, path): path for path in pending}
        for future in as_completed(futures):
            path, result = futures[future], future.result()
            if result is not None:
                usage = result.get("usage", {})
                new = not costs.exists()
                with open(costs, "a") as out:
                    if new:
                        out.write("\t".join(COST_COLUMNS) + "\n")
                    out.write("\t".join([path.stem, str(result.get("total_cost_usd", "")),
                                         *(str(usage.get(c, "")) for c in COST_COLUMNS[2:6]),
                                         str(result.get("duration_ms", ""))]) + "\n")
            missing = left_out(path)
            if missing:
                incomplete.append((path.stem, missing))
            print(f"{path.stem}: " + (f"{len(missing)} left out: {', '.join(missing[:10])}" if missing else "decided"))
    total = sum(float(row["cost_usd"] or 0) for row in read_tsv(costs)) if costs.exists() else 0
    print(f"The run has cost ${total:.2f}." + (f" {len(incomplete)} batches left incomplete; run decide again."
                                                if incomplete else ""))
    return sorted(incomplete)


def review_rows(name, decision):
    """The review rows of the agent's decision on a name."""
    row = dict.fromkeys(REVIEW_COLUMNS, "") | {"name": name, "kind": decision["kind"], "source": SOURCE,
                                               "reason": decision.get("reason", ""), "note": decision.get("note", "")}
    if decision["kind"] == "spelling":
        return [row | {"id": decision["id"], "context": name if decision.get("context") else ""}]
    if decision["kind"] == "new":
        return [row | skill_fields(decision)]
    skill_row = dict.fromkeys(REVIEW_COLUMNS, "") | {"name": name, "source": SOURCE}
    if decision["kind"] == "split":
        return [row] + [skill_row | {"kind": "part"} | skill_fields(part) for part in decision["parts"]]
    if decision["kind"] == "join":
        return [row | {"reason": row["reason"] or f"a fragment of {decision['whole']}"},
                skill_row | {"kind": "whole"} | skill_fields(decision)]
    return [row]


def skill_fields(skill):
    """The review columns of a skill the agent names: its id alone when held, all its fields when new."""
    return {"id": skill["id"], "canonical": skill.get("canonical", ""), "category": skill.get("category", ""),
            "aliases": "|".join(skill.get("aliases", [])), "context": "|".join(skill.get("context", []))}


def collect(run=RUN):
    batches = sorted(run.glob("batch-???.json"))
    incomplete = [path.stem for path in batches if left_out(path)]
    if incomplete:
        sys.exit(f"{len(incomplete)} batches have entries left out: {', '.join(incomplete)}; run decide again")
    rows = []
    for path in batches:
        decisions = json.loads(path.with_suffix(".decisions.json").read_text())
        for entry in json.loads(path.read_text()):
            rows += review_rows(entry["name"], decisions[entry["name"]])
    for name in (run / "unmentioned.txt").read_text().splitlines():
        rows.append(dict.fromkeys(REVIEW_COLUMNS, "") | {"name": name, "kind": "drop", "source": "session",
                                                         "reason": "mentioned in no segment of the snapshot"})
    write_tsv(run / "review.tsv", REVIEW_COLUMNS, [[row[c] for c in REVIEW_COLUMNS] for row in rows])
    print(f"Wrote {len(rows)} rows to {run / 'review.tsv'}")


def append():
    skills, decisions = apply(skillloop.read_skill_rows(), read_tsv(RUN / "review.tsv"))
    with open(skillloop.SKILLS, "w") as out:
        for identifier, canonical, category, keys, context in skills:
            out.write("\t".join([identifier, canonical, category, "|".join(keys[1:]),
                                 "|".join(key for key in keys if key in context)]) + "\n")
    with open(skillloop.DECISIONS, "a") as out:
        for form, decision, source in decisions:
            out.write("\t".join([form, decision, skillloop.criterion_revision(), skillloop.SNAPSHOT, source]) + "\n")
    print(f"{len(skills)} skills in skills.tsv; {len(decisions)} decisions appended.")


def main():
    command, *arguments = sys.argv[1:] or [""]
    if command == "batch" and len(arguments) in (1, 2):
        batch(*arguments)
    elif command == "decide" and not arguments:
        if decide():
            sys.exit(1)
    elif command == "collect" and not arguments:
        collect()
    elif command == "append" and not arguments:
        append()
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main()
