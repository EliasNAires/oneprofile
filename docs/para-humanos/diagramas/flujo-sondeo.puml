@startuml flujo-sondeo
!theme plain
title Que pasa cuando sondeas los boards\nDe un POST a saber a quien vale la pena pedirle vacantes

skinparam shadowing false
skinparam responseMessageBelowArrow true

actor Vos as you
participant "BoardProbeController" as ctrl
participant "executor\n(1 solo hilo)" as exec
participant "GreenhouseBoardProbeService" as svc
participant "GreenhouseBoardClient" as client
participant "API de\nGreenhouse" as gh
database "Postgres" as db

you -> ctrl : POST /admin/probe/greenhouse
ctrl -> exec : encolar el trabajo
ctrl --> you : 202 Accepted
note right of you
  Igual que el descubrimiento:
  tu request termina ACA. Lo que
  sigue tarda media hora y solo
  se ve en el log.
end note

exec -> svc : probeAll()
activate svc
svc -> db : dame todas las\nempresas de Greenhouse
db --> svc : ~4.000 empresas

loop por cada empresa
  svc -> svc : esperar 200 ms
  note left of svc
    La pausa es por respeto:
    son miles de requests contra
    la API de otro.
  end note

  svc -> client : probe(slug)
  activate client
  client -> gh : GET /v1/boards/<slug>/jobs

  alt 404
    gh --> client : "Job not found"
    client --> svc : NOT_FOUND
  else 200 sin vacantes
    gh --> client : total = 0
    client --> svc : EMPTY
  else 200 con vacantes
    gh --> client : total = N, company_name
    client --> svc : ACTIVE, N, "Globant"
  else 5xx o error de red
    client -> gh : reintenta, hasta 3 veces
    client --> svc : excepcion: esa empresa\nse saltea y sigue la proxima
  end
  deactivate client

  svc -> db : anotar estado, nombre y fecha
  note right of db
    Un save por empresa, cada uno
    en su transaccion. Si la corrida
    se corta, lo sondeado queda.
  end note
end

deactivate svc
svc --> exec : 4046 empresas: N sin board,\nN vacias, N con vacantes
exec -> exec : lo escribe en el log

@enduml
