@startuml flujo-descubrimiento
!theme plain
title Que pasa cuando disparas el descubrimiento\nDe un POST a miles de filas en la tabla company

skinparam shadowing false
skinparam responseMessageBelowArrow true

actor Vos as you
participant "DiscoveryController" as ctrl
participant "executor\n(1 solo hilo)" as exec
participant "GreenhouseDiscoveryService" as svc
participant "CommonCrawlIndexClient" as client
participant "GreenhouseBoardUrl" as url
participant "CommonCrawl" as cc
database "Postgres" as db

you -> ctrl : POST /admin/discovery/greenhouse/commoncrawl

alt ya hay una corrida en curso
  ctrl --> you : 409 Conflict
else libre
  ctrl -> exec : encolar el trabajo
  ctrl --> you : 202 Accepted
  note right of you
    Tu request termina ACA, en un
    segundo. Lo que sigue tarda
    minutos y solo se ve en el log.
  end note
end

exec -> svc : discoverOnRecentCommonCrawl()
activate svc
svc -> client : latestIndexIds(10)
client -> cc : collinfo.json
cc --> client : los indices, del mas nuevo al mas viejo
client --> svc : los 10 mas nuevos
note right of svc
  Ningun indice esta escrito en el codigo:
  cuando CommonCrawl publica uno nuevo, entra solo.
end note

loop por cada uno de los 10 indices
  loop por cada uno de los 2 dominios de board
    svc -> client : forEachUrl(indice, dominio, callback)
    activate client
    loop pagina por pagina (~9 MB cada una)
      client -> cc : dame la pagina N
      loop por cada linea, mientras la lee
        client -> svc : callback(url)
        svc -> url : slugFrom(url)
        url --> svc : "mercadolibre"  o  vacio
      end
    end
    deactivate client
  end

  alt el indice contesto
    svc -> db : que slugs ya tengo?
    db --> svc : los conocidos
    svc -> db : guardar los nuevos
    note right of svc
      Se guarda al terminar cada indice, no al final:
      si el septimo falla, lo de los seis anteriores ya quedo.
    end note
  else el indice fallo
    svc -> svc : anotarlo y seguir con el siguiente
  end
end

svc --> exec : lo de cada indice + los que fallaron
deactivate svc
exec -> exec : lo escribe en el log

@enduml
