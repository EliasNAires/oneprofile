@startuml modelo-de-datos
!theme plain
title Que se guarda\nLas clases de Java, y la tabla que hay abajo

skinparam shadowing false
skinparam nodesep 20
skinparam ranksep 40
hide circle

package "En Java" {

  class Company {
    id : Long
    ats : Ats
    slug : String
    .. lo que deja el sondeo ..
    name : String
    boardStatus : BoardStatus
    lastProbedAt : Instant
  }

  enum Ats {
    GREENHOUSE
  }

  enum BoardStatus {
    NOT_FOUND
    EMPTY
    ACTIVE
  }

  Company --> Ats
  Company --> BoardStatus
}

package "En Postgres" {

  entity "company" as t {
    id : bigint  <<PK>>
    --
    ats : varchar
    slug : varchar
    --
    name : varchar
    board_status : varchar
    last_probed_at : timestamptz
    --
    **unique (ats, slug)**
  }

  entity "company_seq" as s {
    da los id de a 50 por vez
  }
}

Company ..> t : Flyway crea y modifica la tabla.\nAl arrancar, Hibernate\ncompara y falla si no coinciden.

@enduml
