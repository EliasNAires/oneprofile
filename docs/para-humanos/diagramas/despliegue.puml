@startuml despliegue
!theme plain
title Como llega el codigo al servidor

skinparam shadowing false
skinparam nodesep 25
skinparam ranksep 35

node "TU MAQUINA" as local {
  component "el repo" as repo
}

node "GITHUB" as gh {
  component "Actions\n\n1. mvn test\n2. construye la imagen" as actions
  component "GHCR\n\nghcr.io/eliasnaires/\noneprofile-backend:latest" as ghcr
  actions -down-> ghcr : publica
}

node "SERVIDOR (por SSH)" as server {
  component "la app,\nen su propio container\n\nningun puerto publicado" as app
  node "container postgres" as db {
    component "Postgres 18" as pg
    database "volumen nombrado\n\naca viven los datos" as vol
    pg -down-> vol
  }
  app -down-> pg
}

repo -right-> actions : git push a main
ghcr -down-> app : docker compose pull\ndocker compose up -d

@enduml
