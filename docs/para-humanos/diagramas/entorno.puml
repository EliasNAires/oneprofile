@startuml entorno
!theme plain
title Donde corre\nDesarrollo y produccion, lado a lado

skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 30

node "DESARROLLO\n./mvnw spring-boot:run" as dev {
  component "la app,\nen tu maquina\n\npuerto 8080 abierto" as devapp
  node "container postgres" as devdb {
    component "Postgres 18\n\nsin volumen:\nal bajarlo se\npierde todo" as devpg
  }
  devapp -down-> devpg : lo levanta\nSpring Boot solo
}

node "PRODUCCION\ncd prod && docker compose up --build -d" as prod {
  component "la app,\nen su propio container\n\nningun puerto publicado" as papp
  node "container postgres" as proddb {
    component "Postgres 18" as ppg
    database "volumen nombrado\n\naca si persiste" as vol
    ppg -down-> vol
  }
  papp -down-> ppg
}

dev -[hidden]right- prod

@enduml
